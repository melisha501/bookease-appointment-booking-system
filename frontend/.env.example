# Local development: leave VITE_API_BASE unset to use the Vite proxy
# (/api -> http://localhost:5000).
#
# Production (Vercel): set the full Render API URL, including /api. This is
# recommended so a frontend rebuild cannot silently fall back to the wrong
# backend. If it is unset on a *.vercel.app host, the app uses this project's
# Render API as a safety net because Vercel rewrites /api/* to index.html.
# VITE_API_BASE=https://bookease-appointment-booking-system.onrender.com/api
