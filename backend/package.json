{
  "name": "appointment-booking-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Appointment & Service Booking System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "email:test": "node scripts/send-test-email.js",
    "uploadthing:check": "node scripts/uploadthing-check.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node src/seed.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "resend": "^6.37.0",
    "uploadthing": "^7.7.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
