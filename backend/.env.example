# Copy to .env and fill in your values
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Number of reverse-proxy hops to trust for client IPs (rate limiting).
# Render and similar PaaS hosts need 1. Local development can leave this unset.
# TRUST_PROXY=1

# Primary browser origin allowed by CORS (the deployed Vercel URL in production).
FRONTEND_URL=http://localhost:5173

# Optional comma-separated extra origins, e.g. a custom domain + Vercel preview.
# CORS_ORIGINS=https://www.yourdomain.com,https://bookease.vercel.app

# Vercel preview deployments (default: enabled).
# Preview URLs for THIS project are accepted automatically using a strict
# hostname pattern: https://<project>-<deployment-or-branch>-<team>.vercel.app.
# This is not a bare *.vercel.app wildcard; other Vercel projects stay blocked.
# Override the project/team slugs if the Vercel project moves.
# VERCEL_PREVIEW_PROJECT=bookease-appointment-booking-system
# VERCEL_PREVIEW_TEAM=melisha
# Set to false to allow only FRONTEND_URL and CORS_ORIGINS.
# ALLOW_VERCEL_PREVIEWS=true

# Authentication rate limiting (applies only to POST /api/auth/login and /register).
# Successful logins are not counted, so normal use cannot lock an IP out.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_LOGIN_MAX=10
# AUTH_RATE_LIMIT_REGISTER_MAX=5

# PostgreSQL connection string (required for Prisma)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_booking?schema=public"

# JWT secret (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Resend email notifications (optional but recommended)
# 1) Create an account at https://resend.com and create an API key.
# 2) In production, verify your sending domain and set RESEND_FROM_EMAIL to an
#    address on that domain. The shared test sender onboarding@resend.dev is a
#    development/test fallback only; it delivers solely to the Resend account
#    owner and is never used automatically when NODE_ENV=production.
# 3) Set a comma-separated admin recipient list for new-booking alerts.
# 4) Set APP_URL (or FRONTEND_URL) to the deployed frontend so email buttons
#    never point at localhost in production.
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="BookEase <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"

# Optional email settings
# EMAIL_REPLY_TO="support@example.com"
# SUPPORT_EMAIL="hello@bookease.com.np"
# APP_NAME="BookEase"
# APP_URL="http://localhost:5173"

# Email retry/outbox tuning (database-backed; safe defaults shown).
# Temporary Resend failures are retried with exponential backoff.
# EMAIL_OUTBOX_MAX_ATTEMPTS=5
# EMAIL_OUTBOX_BASE_DELAY_MS=60000
# EMAIL_OUTBOX_MAX_DELAY_MS=3600000
# EMAIL_OUTBOX_STUCK_AFTER_MS=300000
# EMAIL_OUTBOX_BATCH_SIZE=20
# EMAIL_OUTBOX_INTERVAL_MS=30000

# UploadThing image uploads (service/specialist images)
# The installed SDK is uploadthing v7. Copy the V7 token from
# UploadThing Dashboard -> API Keys -> V7 and keep it server-side only.
# Never put this token in frontend code or Vercel environment variables.
# Do not use a legacy v6 secret here; it is not a v7 token.
# UPLOADTHING_TOKEN="paste_the_complete_v7_token_here"
